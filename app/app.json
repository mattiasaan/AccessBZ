{
  "expo": {
    "name": "AccessBZ",
    "slug": "accessbz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6F8",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "it.accessbz.app",
      "buildNumber": "1"
    },
    "android": {
      "package": "it.accessbz.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#2457E6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AccessBZ usa la tua posizione per mostrarti gli ostacoli vicini e localizzare le segnalazioni.",
          "locationAlwaysAndWhenInUsePermission": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AccessBZ usa la fotocamera per fotografare gli ostacoli che segnali.",
          "photosPermission": "AccessBZ accede alle foto per allegarle alle segnalazioni.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F8"
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "apiUrl": "https://accessbz-api.onrender.com",
      "eas": {
        "projectId": "76b4c8af-0512-4bab-bc7d-9f503db85913"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "owner": "mattiasan"
  }
}
