{
  "expo": {
    "name": "AccessBZ",
    "slug": "accessbz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "it.accessbz.app"
    },
    "android": {
      "package": "it.accessbz.app",
      "adaptiveIcon": {
        "backgroundColor": "#1F5FBF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AccessBZ usa la tua posizione per mostrarti gli ostacoli vicini e localizzare le segnalazioni."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "AccessBZ usa la fotocamera per fotografare gli ostacoli che segnali.",
          "photosPermission": "AccessBZ accede alle foto per allegarle alle segnalazioni."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://accessbz-api.onrender.com"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
