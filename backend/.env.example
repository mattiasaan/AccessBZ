# Copia questo file come ".env" (nella stessa cartella) e inserisci la tua chiave.
# Il file .env non va caricato su GitHub: è già escluso da .gitignore.
ORS_API_KEY=incolla_qui_la_tua_chiave

# Moltiplica i limiti di richieste per IP (1 = normale, 2 = il doppio). Utile per una demo con tante persone sulla stessa rete.
RATE_LIMIT_SCALE=1
